# This project is pnpm-only. `engine-strict` makes the "npm": "please-use-pnpm"
# entry in package.json#engines a hard error, so `npm install` fails fast
# instead of quietly producing a second, conflicting lockfile.
engine-strict=true

# Next.js 14 shells out to `npm config get registry` on dev/build startup. npm
# then prints "Unknown env config" warnings for every pnpm-specific key pnpm
# puts in the environment (verify-deps-before-run, _jsr-registry, ...). Nothing
# is broken — it is npm complaining about pnpm — but it clutters every `pnpm
# dev`. We never invoke npm intentionally here, so drop its log level.
#
# Note: keep pnpm-only settings OUT of this file. npm reads it too, and each
# key it doesn't recognise becomes another warning line.
loglevel=error
