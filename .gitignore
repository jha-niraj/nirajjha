# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# lockfiles from other package managers — this project is pnpm-only and
# pnpm-lock.yaml is the one that gets committed
package-lock.json
yarn.lock
bun.lockb

# local env files
# `.env*.local` alone does NOT cover a plain `.env`, which is where the Neon
# connection string lives. Ignore every env file and re-include the example.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
