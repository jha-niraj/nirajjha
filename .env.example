# Neon Postgres connection string.
#
# Copy this file to .env.local and paste your URL below, then run:
#   pnpm db:push
#
# Get it from https://console.neon.tech -> your project -> Connection Details.
# Use the *pooled* connection string (the host contains "-pooler") and keep
# ?sslmode=require on the end.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# Without DATABASE_URL the site still builds and runs; views, reactions and
# comments simply render as zero and the comment form reports that the store
# is offline.

# --- Resend -----------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# A verified sender on a domain you own, e.g. "Niraj <hello@nirajjha.in>"
RESEND_FROM_EMAIL=
# Resend renamed Audiences to Segments. This one id is used for both:
# contacts.create takes it as `audienceId`, broadcasts.create as `segmentId`.
# Run `pnpm resend:setup` to create it and print the id.
# Leave blank and it is resolved by name (RESEND_SEGMENT_NAME) on first use,
# which costs two extra API calls per cold start and nothing else.
RESEND_SEGMENT_ID=
RESEND_SEGMENT_NAME=nirajjha.in

# Absolute origin used in broadcast emails. Defaults to https://nirajjha.in.
SITE_URL=

# --- OpenAI -----------------------------------------------------------------
# Powers the reading assistant panel on each post (gpt-4o-mini).
# https://platform.openai.com/api-keys
# Without it the panel still renders and returns a clear "not configured" message.
OPENAI_API_KEY=

# --- Admin panel ------------------------------------------------------------
# Random 32+ char string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin auth cookies are issued for. http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000
# Used once by `pnpm admin:seed` to create the only account. Re-running the
# seed with a new password resets it, which is the password-change mechanism.
ADMIN_EMAIL=
ADMIN_PASSWORD=
